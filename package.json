{
  "name": "notorium",
  "version": "0.1.0",
  "description": "A learning app for making and reviewing notes and flashcards with AI help",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check:size": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-file-size.ts",
    "check:deadcode": "DATABASE_URL=postgres://stub knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:infra:up": "docker compose -f compose.test.yml --env-file .env.test up -d",
    "test:e2e:infra:down": "docker compose -f compose.test.yml --env-file .env.test down -v",
    "test:e2e:migrate": "dotenv -e .env.test -- drizzle-kit migrate",
    "test:e2e:build": "dotenv -e .env.test -- next build",
    "test:e2e:start": "dotenv -e .env.test -- next start",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:headed": "dotenv -e .env.test -- playwright test --headed"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.141",
    "@hookform/resolvers": "^5.2.2",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@open-spaced-repetition/binding": "^0.5.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.138",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "katex": "0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.56.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "redis": "^6.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joaogiacometti/notorium.git"
  },
  "keywords": [
    "study",
    "education",
    "flashcards",
    "notes",
    "spaced-repetition"
  ],
  "author": "João Pedro Giacometti Guerreiro <j.guerreiro@unesp.br>",
  "bugs": {
    "url": "https://github.com/joaogiacometti/notorium/issues"
  },
  "homepage": "https://github.com/joaogiacometti/notorium#readme",
  "allowScripts": {
    "lefthook": true,
    "esbuild": false,
    "msw": false
  }
}
