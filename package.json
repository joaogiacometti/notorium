{
  "name": "notorium",
  "version": "0.1.0",
  "description": "A knowledge editor for writing notes, reading PDFs, and remembering what matters with spaced repetition",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check:size": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-file-size.ts",
    "check:deadcode": "DATABASE_URL=postgres://stub knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:backfill:fsrs7": "tsx scripts/backfill-fsrs7.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:infra:up": "docker compose -f compose.test.yml --env-file .env.test up -d",
    "test:e2e:infra:down": "docker compose -f compose.test.yml --env-file .env.test down -v",
    "test:e2e:migrate": "dotenv -e .env.test -- drizzle-kit migrate",
    "test:e2e:build": "dotenv -e .env.test -- next build",
    "test:e2e:start": "dotenv -e .env.test -- next start",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:headed": "dotenv -e .env.test -- playwright test --headed",
    "eval": "dotenv -e .env -- vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.181",
    "@hookform/resolvers": "^7.0.7",
    "@open-spaced-repetition/binding": "^0.6.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/extension-typography": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/static-renderer": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.177",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.18",
    "drizzle-orm": "^0.45.4",
    "katex": "0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-pdf": "11.1.0",
    "redis": "^6.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.9"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joaogiacometti/notorium.git"
  },
  "keywords": [
    "study",
    "education",
    "flashcards",
    "notes",
    "spaced-repetition"
  ],
  "author": "João Pedro Giacometti Guerreiro <j.guerreiro@unesp.br>",
  "bugs": {
    "url": "https://github.com/joaogiacometti/notorium/issues"
  },
  "homepage": "https://github.com/joaogiacometti/notorium#readme",
  "allowScripts": {
    "lefthook": true,
    "esbuild": false,
    "msw": false
  }
}
