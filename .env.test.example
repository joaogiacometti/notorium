# Test app runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/notorium_test
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=replace-with-a-random-64-char-secret-for-testing
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://localhost:6380
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001
NOTORIUM_MEDIA_STORAGE_FIXTURE_DIR=test-results/media-storage-fixture

# Required integrations: placeholders, since tests never call the real services
OPENROUTER_API_KEY=playwright-openrouter-key
OPENROUTER_MODEL=playwright-openrouter-model
BLOB_READ_WRITE_TOKEN=playwright-blob-token
RESEND_API_KEY=playwright-resend-key
RESEND_FROM_EMAIL="Notorium <notifications@example.com>"
CRON_SECRET=playwright-cron-secret-0123456789abcdef

# Test Docker Compose helpers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notorium_test
POSTGRES_PORT=5433
REDIS_PORT=6380
